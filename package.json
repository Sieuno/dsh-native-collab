{
  "name": "@sieuno/dsh-native-collab",
  "version": "0.4.0",
  "description": "DeepSeek Harness collaboration extensions: subagent model sources, a shared automatic message allowance, and improved delegation prompts.",
  "icon": "./icons/subagent.svg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "=0.2.2-rc.2 || =0.2.2-rc.3"
  },
  "files": [
    "dist/native/*.js",
    "dist/client.js",
    "locale/*.json",
    "locale/settings.*.md",
    "icons/subagent.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "TESTING.md",
    "docs/INSTALL*.md",
    "docs/FAQ*.md"
  ],
  "exports": {
    ".": "./dist/native/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icons/subagent.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/native-build.mjs",
    "validate:package": "node scripts/native-package.mjs",
    "check:types": "node scripts/native-typecheck.mjs",
    "check:authors": "node scripts/check-commit-attribution.mjs",
    "check:load": "node --import ./scripts/native-sdk-hook.mjs --test tests/native-startup.test.mjs",
    "test": "node --test tests/auto-wake.test.mjs tests/package.test.mjs tests/publication.test.mjs",
    "test:sdk": "node --import ./scripts/native-sdk-hook.mjs --test tests/native-tools.test.mjs tests/native-startup.test.mjs tests/native-host.test.mjs tests/settings-client.test.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-agent": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-subagent": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-subagent-control": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "=0.2.2-rc.2 || =0.2.2-rc.3",
    "@deepseek-ai/dsh-settings": "=0.2.2-rc.2 || =0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-subagent-control": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sieuno/dsh-native-collab.git"
  },
  "homepage": "https://github.com/Sieuno/dsh-native-collab#readme",
  "bugs": {
    "url": "https://github.com/Sieuno/dsh-native-collab/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-team",
    "subagent"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
