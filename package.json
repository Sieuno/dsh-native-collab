{
  "name": "@dsh-native-collab/derived",
  "version": "0.2.0",
  "private": true,
  "description": "Flexible Agent Teams and model selection for DSH, with enhanced communication between parent and child conversations. 让 DSH 的 Agent Team 更灵活：灵活选择模型，增强父子对话通信。 Unofficial community plugin / 非官方社区插件。",
  "icon": "./icons/subagent.svg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.2.2-0"
  },
  "files": [
    "dist/**/*.js",
    "locale/*.json",
    "packages/agent-team/locale/*.json",
    "packages/agent-team/LICENSE",
    "packages/subagent/locale/*.json",
    "packages/subagent/LICENSE",
    "packages/subagent/NOTICE",
    "packages/tool-agent-team/locale/*.json",
    "packages/tool-agent-team/LICENSE",
    "packages/tool-subagent-control/locale/*.json",
    "packages/tool-subagent-control/locale/list-agents/*.json",
    "packages/tool-subagent-control/LICENSE",
    "packages/tool-subagent-control/NOTICE",
    "packages/tool-subagent/locale/*.json",
    "packages/tool-subagent/locale/fork/*.json",
    "packages/tool-subagent/LICENSE",
    "scripts/check-release.mjs",
    "scripts/make-overlays.mjs",
    "cordis.patch.yml",
    "icons/*.svg",
    "README.md",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/images/*.png",
    "examples/*.yml",
    "README.en.md",
    "docs/INSTALL.md",
    "docs/FAQ.md"
  ],
  "exports": {
    ".": "./dist/agent-team/bootstrap.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./agent-team": "./dist/agent-team/index.js",
    "./subagent": "./dist/subagent/index.js",
    "./subagent/internal": "./dist/subagent/internal.js",
    "./tool-agent-team": "./dist/tool-agent-team/index.js",
    "./tool-subagent-control": "./dist/tool-subagent-control/index.js",
    "./tool-subagent-control/list-agents": "./dist/tool-subagent-control/list-agents.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icons/subagent.svg",
    "./agent-team/locale/*.json": "./packages/agent-team/locale/*.json",
    "./agent-team/icon": "./icons/agent-team.svg",
    "./subagent/locale/*.json": "./packages/subagent/locale/*.json",
    "./subagent/icon": "./icons/subagent.svg",
    "./tool-agent-team/locale/*.json": "./packages/tool-agent-team/locale/*.json",
    "./tool-agent-team/icon": "./icons/tool-agent-team.svg",
    "./tool-subagent-control/locale/*.json": "./packages/tool-subagent-control/locale/*.json",
    "./tool-subagent-control/icon": "./icons/tool-subagent-control.svg",
    "./tool-subagent-control/list-agents/locale/*.json": "./packages/tool-subagent-control/locale/list-agents/*.json",
    "./tool-subagent-control/list-agents/icon": "./icons/tool-subagent-list-agents.svg",
    "./tool-subagent": "./dist/tool-subagent/index.js",
    "./tool-subagent/locale/*.json": "./packages/tool-subagent/locale/*.json",
    "./tool-subagent/icon": "./icons/tool-subagent.svg",
    "./tool-subagent/fork": "./dist/tool-subagent/fork.js",
    "./tool-subagent/fork/locale/*.json": "./packages/tool-subagent/locale/fork/*.json",
    "./tool-subagent/fork/icon": "./icons/tool-subagent-fork.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-release.mjs",
    "validate:package": "node scripts/check-release.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "zod": "4.4.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1 <0.2.2-0",
