    "@deepseek-ai/dsh-storage": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1 <0.2.2-0",
